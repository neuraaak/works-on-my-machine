[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
license = "{{ license }}"
{%- if author_name %}
authors = [{ name = "{{ author_name }}" }]
maintainers = [{ name = "{{ author_name }}" }]
{%- endif %}
classifiers = [
    "Development Status :: 3 - Alpha",
    "Intended Audience :: Developers",
    "Operating System :: OS Independent",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: {{ python_version }}",
    "Topic :: Software Development :: Libraries :: Python Modules",
]
requires-python = ">={{ python_version }}"
dependencies = [
{%- if framework == "django" %}
    "django>=5.0",
{%- endif %}
]

[dependency-groups]
dev = [
    "ruff>=0.5.0",
    "ty>=0.0.13",
    "pre-commit>=3.0.0",
{%- if with_tests %}
    "pytest>=7.0.0",
    "pytest-cov>=4.0.0",
{%- endif %}
{%- if with_tests and framework == "django" %}
    "pytest-django>=4.8.0",
{%- endif %}
{%- if framework == "django" %}
    "django-stubs>=5.0.0",
{%- endif %}
]
{%- if with_tests %}
test = [
    "pytest>=7.0.0",
    "pytest-cov>=4.0.0",
{%- if framework == "django" %}
    "pytest-django>=4.8.0",
{%- endif %}
]
{%- endif %}

[tool.hatch.build.targets.wheel]
{%- if use_src_layout %}
packages = ["src/{{ package_name }}"]
{%- else %}
packages = ["{{ package_name }}"]
{%- endif %}

[tool.ruff]
target-version = "py{{ python_version | replace('.', '') }}"
line-length = 88

[tool.ruff.lint]
select = ["E", "W", "F", "I", "B", "C4", "UP", "SIM", "N", "ANN", "RUF"]
ignore = ["E501"]

[tool.ruff.format]
quote-style = "double"
docstring-code-format = true

[tool.ty.environment]
python-version = "{{ python_version }}"
{%- if use_src_layout %}
root = ["src"]
{%- else %}
root = ["."]
{%- endif %}

[tool.ty.src]
{%- if use_src_layout %}
include = ["src/{{ package_name }}"]
{%- else %}
include = ["{{ package_name }}"]
{%- endif %}
respect-ignore-files = true
{%- if with_tests %}

[tool.pytest.ini_options]
minversion = "7.0"
addopts = ["--strict-markers", "--strict-config"]
testpaths = ["tests"]
python_files = ["test_*.py"]
python_functions = ["test_*"]
{%- if framework == "django" %}
DJANGO_SETTINGS_MODULE = "{{ package_name }}.settings"
{%- endif %}

[tool.coverage.run]
{%- if use_src_layout %}
source = ["src/{{ package_name }}"]
{%- else %}
source = ["{{ package_name }}"]
{%- endif %}
branch = true

[tool.coverage.report]
exclude_lines = [
    "pragma: no cover",
    "if TYPE_CHECKING:",
    "raise NotImplementedError",
]
{%- endif %}
