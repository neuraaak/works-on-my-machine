{
    "compilerOptions": {
        "target": "ES2021",
        "lib": ["ES2021"{% if framework in ("react", "vue") %}, "DOM", "DOM.Iterable"{% endif %}],
        "module": "ESNext",
        "moduleResolution": "node",
{%- if framework == "react" %}
        "jsx": "react-jsx",
{%- elif framework == "vue" %}
        "jsx": "preserve",
{%- endif %}
        "outDir": "./dist",
        "rootDir": "./src",
        "declaration": true,
        "sourceMap": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "strict": true,
        "noImplicitAny": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "build", "coverage"]
{%- if framework == "vue" %},
    "vueCompilerOptions": {
        "target": 3
    }
{%- endif %}

}
