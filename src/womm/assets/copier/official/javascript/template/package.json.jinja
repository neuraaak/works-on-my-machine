{%- set source_entry = ("src/index." if framework == "react" else "src/main.") + ("tsx" if (typescript and framework == "react") else "ts" if typescript else "jsx" if framework == "react" else "js") -%}
{%- set runtime_entry = "dist/main.js" if typescript else source_entry -%}
{%- set use_biome = framework != "vue" -%}
{%- set deps = [] -%}
{%- set dev_deps = ['"@biomejs/biome": "^2.5.0"'] if use_biome else [
  '"@eslint/js": "^10.0.0"',
  '"eslint": "^10.7.0"',
  '"eslint-config-prettier": "^10.1.0"',
  '"globals": "^16.0.0"',
  '"prettier": "3.9.0"'
] -%}
{%- if framework == "react" -%}
{%- set _ = deps.extend(['"react": "^19.2.0"', '"react-dom": "^19.2.0"']) -%}
{%- set _ = dev_deps.extend(['"@vitejs/plugin-react": "^6.0.0"', '"vite": "^8.1.0"']) -%}
{%- elif framework == "vue" -%}
{%- set _ = deps.append('"vue": "^3.5.0"') -%}
{%- set _ = dev_deps.extend([
  '"@vitejs/plugin-vue": "^6.0.0"',
  '"eslint-plugin-vue": "^10.0.0"',
  '"vite": "^8.1.0"',
  '"vue-eslint-parser": "^10.0.0"'
]) -%}
{%- endif -%}
{%- if typescript -%}
{%- set _ = dev_deps.extend(['"@types/node": "^24.0.0"', '"typescript": "^5.9.0"']) -%}
{%- if not use_biome -%}
{%- set _ = dev_deps.append('"typescript-eslint": "^8.0.0"') -%}
{%- endif -%}
{%- if framework == "react" -%}
{%- set _ = dev_deps.extend(['"@types/react": "^19.0.0"', '"@types/react-dom": "^19.0.0"']) -%}
{%- elif framework == "vue" -%}
{%- set _ = dev_deps.append('"vue-tsc": "^3.0.0"') -%}
{%- endif -%}
{%- endif -%}
{%- if with_tests -%}
{%- set _ = dev_deps.append('"vitest": "^4.1.0"') -%}
{%- endif -%}
{
  "name": "{{ project_name }}",
  "version": "0.1.0",
  "description": "{{ description }}",
  "private": true,
  "type": "module",
{%- if author_name %}
  "author": "{{ author_name }}",
{%- endif %}
  "license": "{{ license }}",
{%- if package_manager == "pnpm" %}
  "packageManager": "pnpm@10.0.0",
{%- elif package_manager == "yarn" %}
  "packageManager": "yarn@4.6.0",
{%- elif package_manager == "bun" %}
  "packageManager": "bun@1.2.0",
{%- endif %}
{%- if framework == "none" %}
  "main": "{{ runtime_entry }}",
{%- endif %}
  "scripts": {
{%- if framework in ("react", "vue") %}
    "dev": "vite",
    "build": "{% if typescript and framework == 'vue' %}vue-tsc --noEmit && {% elif typescript %}tsc --noEmit && {% endif %}vite build",
    "preview": "vite preview",
{%- else %}
    "dev": "node {{ source_entry }}",
    "build": "{% if typescript %}tsc -p tsconfig.json{% else %}node --check {{ source_entry }}{% endif %}",
    "start": "node {{ runtime_entry }}",
{%- endif %}
    "lint": "{% if use_biome %}biome lint .{% else %}eslint .{% endif %}",
    "lint:fix": "{% if use_biome %}biome lint --write .{% else %}eslint . --fix{% endif %}",
    "format": "{% if use_biome %}biome format --write .{% else %}prettier --write .{% endif %}",
    "format:check": "{% if use_biome %}biome format .{% else %}prettier --check .{% endif %}"{% if typescript %},
    "type-check": "{% if framework == 'vue' %}vue-tsc{% else %}tsc{% endif %} --noEmit"{% endif %}{% if with_tests %},
    "test": "vitest run",
    "test:watch": "vitest"{% endif %}
  },
  "dependencies": {% if deps %}{
{%- for entry in deps %}
    {{ entry }}{% if not loop.last %},{% endif %}
{%- endfor %}
  }{% else %}{}{% endif %},
  "devDependencies": {
{%- for entry in dev_deps | sort %}
    {{ entry }}{% if not loop.last %},{% endif %}
{%- endfor %}
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
